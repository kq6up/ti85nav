\START\
\COMMENT=SIGHT unified Air Nautical full reduction
\NAME=SIGHT
\FILE=SIGHT.85P
Degree
ClLCD
Disp "SIGHT VERSION8"
Disp "RUN SETUP FIRST"
Disp "1 AIR 2 NAUT"
Prompt W
Disp "1SUN 2MOON"
Disp "3PLNT 4STAR"
Prompt B
Disp "1SEA 2AH"
Prompt J
ClLCD
Disp "HS DD.MMm"
Prompt X
iPart(X)\->\D
fPart(X)*100\->\M
D+M/60\->\H
H+I/60\->\H
0\->\Q
If J\>=\2
Goto R
1.76*E^.5\->\Q
H-Q/60\->\H
Goto F
Lbl R
H/2\->\H
Lbl F
.267*P/(tan(H+.04848/(tan(H)+.028))*(T+273.15))\->\R
H-R/60\->\H
0\->\V
0\->\S
0\->\Y
3\->\N
ClLCD
If B\>=\4
Goto C4
If B\>=\3
Goto C3
If B\>=\2
Goto C2
Goto C1
Lbl C1
Disp "SUN SD MIN"
Prompt S
Disp "LIMB 1L 2U 3C"
Prompt N
0\->\Y
If N<1.5
S\->\Y
If abs(N-2)<.5
0-S\->\Y
H+Y/60\->\H
Goto C9
Lbl C2
Disp "MOON SD MIN"
Prompt S
Disp "LIMB 1L 2U 3C"
Prompt N
0\->\Y
If N<1.5
S\->\Y
If abs(N-2)<.5
0-S\->\Y
If W<2
Goto C5
Goto C6
Lbl C5
Disp "MOON P-IN-A"
Prompt V
H+Y/60\->\H
H+V/60\->\H
Goto C9
Lbl C6
Disp "MOON HP MIN"
Prompt V
Y*(1+sin(V/60)*sin(H))\->\Y
H+Y/60\->\H
\sin^-1\(sin(V/60)*cos(H))\->\Q
H+Q\->\H
Goto C9
Lbl C3
If W<2
Goto C9
Disp "PLANET HP MIN"
Prompt V
\sin^-1\(sin(V/60)*cos(H))\->\Q
H+Q\->\H
Goto C9
Lbl C4
Goto C9
Lbl C9
H\->\U
ClLCD
Disp "POSITION"
Disp "1 STORED 2 TEMP"
Prompt J
If J\>=\2
Goto Q
A\->\Q
O\->\V
Goto V
Lbl Q
Disp "LAT N+ S-"
Disp "DD.MMm"
Prompt X
1\->\F
If X<0
0-1\->\F
abs(X)\->\X
iPart(X)\->\D
fPart(X)*100\->\M
F*(D+M/60)\->\Q
ClLCD
Disp "LON W+ E-"
Disp "DD.MMm"
Prompt X
1\->\F
If X<0
0-1\->\F
abs(X)\->\X
iPart(X)\->\D
fPart(X)*100\->\M
F*(D+M/60)\->\V
Lbl V
If W\>=\2
Goto N
ClLCD
Disp "AIR ALMANAC"
Disp "1 EXACT 2 INTERP"
Prompt J
If J\>=\2
Goto X
Disp "TOTAL GHA"
Disp "DD.MMm"
Prompt X
iPart(X)\->\D
fPart(X)*100\->\M
D+M/60\->\G
Disp "TOTAL DEC N+S-"
Disp "DD.MMm"
Prompt X
1\->\F
If X<0
0-1\->\F
abs(X)\->\X
iPart(X)\->\D
fPart(X)*100\->\M
F*(D+M/60)\->\C
Goto H
Lbl X
ClLCD
Disp "MIN INTO 10"
Disp "MM.SS"
Prompt J
iPart(J)+fPart(J)*100/60\->\J
Disp "GHA ROW1"
Disp "DD.MMm"
Prompt X
iPart(X)\->\D
fPart(X)*100\->\M
D+M/60\->\R
Disp "GHA ROW2"
Prompt X
iPart(X)\->\D
fPart(X)*100\->\M
D+M/60\->\S
If S<R
S+360\->\S
R+(S-R)*J/10\->\G
ClLCD
Disp "DEC ROW1 N+S-"
Disp "DD.MMm"
Prompt X
1\->\F
If X<0
0-1\->\F
abs(X)\->\X
iPart(X)\->\D
fPart(X)*100\->\M
F*(D+M/60)\->\R
Disp "DEC ROW2 N+S-"
Prompt X
1\->\F
If X<0
0-1\->\F
abs(X)\->\X
iPart(X)\->\D
fPart(X)*100\->\M
F*(D+M/60)\->\S
R+(S-R)*J/10\->\C
Goto H
Lbl N
ClLCD
Disp "NAUT ALMANAC"
Disp "MM.SS AFTER HR"
Prompt J
iPart(J)+fPart(J)*100/60\->\J
If B\>=\4
Goto S
ClLCD
Disp "BODY GHA HOUR"
Disp "DD.MMm"
Prompt X
iPart(X)\->\D
fPart(X)*100\->\M
D+M/60\->\G
G+15*J/60\->\G
If abs(B-2)<.5
G+((14+19/60)-15)*J/60\->\G
0\->\R
If abs(B-2)<.5
Goto MV
If abs(B-3)<.5
Goto PV
Goto NV
Lbl MV
Disp "MOON V MIN/HR"
Disp "+ ADD"
Prompt R
Goto NV
Lbl PV
Disp "PLANET V SIGNED"
Disp "MIN/HR"
Prompt R
Lbl NV
G+R*J/3600\->\G
ClLCD
Disp "DEC AT HOUR"
Disp "N+ S- DD.MMm"
Prompt X
1\->\F
If X<0
0-1\->\F
abs(X)\->\X
iPart(X)\->\D
fPart(X)*100\->\M
F*(D+M/60)\->\C
Disp "D SIGNED MIN/HR"
Disp "+ = NORTHWARD"
Prompt X
C+X*J/3600\->\C
Goto H
Lbl S
ClLCD
Disp "ARIES GHA HOUR"
Disp "DD.MMm"
Prompt X
iPart(X)\->\D
fPart(X)*100\->\M
D+M/60\->\G
G+15.04107*J/60\->\G
Disp "STAR SHA DD.MMm"
Prompt X
iPart(X)\->\D
fPart(X)*100\->\M
G+D+M/60\->\G
Disp "STAR DEC N+S-"
Disp "DD.MMm"
Prompt X
1\->\F
If X<0
0-1\->\F
abs(X)\->\X
iPart(X)\->\D
fPart(X)*100\->\M
F*(D+M/60)\->\C
Lbl H
If G<0
G+360\->\G
If G\>=\360
G-360\->\G
If G\>=\360
G-360\->\G
G-V\->\L
If L<0
L+360\->\L
If L\>=\360
L-360\->\L
sin(Q)*sin(C)+cos(Q)*cos(C)*cos(L)\->\R
If R>1
1\->\R
If R<0-1
0-1\->\R
\sin^-1\(R)\->\K
(sin(C)-sin(Q)*sin(K))/(cos(Q)*cos(K))\->\R
If R>1
1\->\R
If R<0-1
0-1\->\R
\cos^-1\(R)\->\Z
Z\->\N
If L<180
360-Z\->\N
If N\>=\360
N-360\->\N
If Q<0
180-Z\->\Z
60*(U-K)\->\F
ClLCD
iPart(U)\->\D
fPart(U)*60\->\M
D+M/100\->\X
Disp "HO DD.MMm"
Disp X
iPart(G)\->\D
fPart(G)*60\->\M
D+M/100\->\X
Disp "GHA DD.MMm"
Disp X
iPart(C)\->\D
fPart(C)*60\->\M
D+M/100\->\X
Disp "DEC DD.MMm"
Disp X
Pause
ClLCD
iPart(L)\->\D
fPart(L)*60\->\M
D+M/100\->\X
Disp "LHA DD.MMm"
Disp X
iPart(K)\->\D
fPart(K)*60\->\M
D+M/100\->\X
Disp "HC DD.MMm"
Disp X
iPart(Z)\->\D
fPart(Z)*60\->\M
D+M/100\->\X
Disp "Z DD.MMm"
Disp X
Pause
ClLCD
iPart(N)\->\D
fPart(N)*60\->\M
D+M/100\->\X
Disp "ZN DD.MMm"
Disp X
Disp "INTERCEPT NM"
Disp abs(F)
If F<0
Goto Y
Disp "TOWARD"
Goto T
Lbl Y
Disp "AWAY"
Lbl T
Pause
\STOP\
