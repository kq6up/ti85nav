\START\
\COMMENT=SETUP persistent sight reduction defaults
\NAME=SETUP
\FILE=SETUP.85P
Degree
ClLCD
Disp "NAV SETUP"
Disp "DR/AP LAT N+ S-"
Disp "DD.MMm"
Prompt X
1\->\F
If X<0
0-1\->\F
abs(X)\->\X
iPart(X)\->\D
fPart(X)*100\->\M
F*(D+M/60)\->\A
ClLCD
Disp "DR/AP LON W+ E-"
Disp "DD.MMm"
Prompt X
1\->\F
If X<0
0-1\->\F
abs(X)\->\X
iPart(X)\->\D
fPart(X)*100\->\M
F*(D+M/60)\->\O
ClLCD
Disp "IC MIN +ADD"
Prompt I
Disp "EYE HT METERS"
Prompt E
Disp "TEMP C"
Prompt T
Disp "PRESS HPA"
Prompt P
ClLCD
Disp "SETUP SAVED"
Disp "LAT DEC DEG"
Disp A
Disp "LON W+ E-"
Disp O
Pause
\STOP\
