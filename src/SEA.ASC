\START\
\COMMENT=SEA sextant corrections Hs to Ho computed
\NAME=SEA
\FILE=SEA.85P
Degree
ClLCD
Disp "SEA HS-HO"
Disp "1SUN 2MOON"
Disp "3PLNT 4STAR"
Prompt B
Disp "HS DD.MMm"
Prompt X
iPart(X)\->\D
fPart(X)*100\->\M
D+M/60\->\H
Disp "IC MIN +ADD"
Prompt I
H+I/60\->\H
Disp "EYE HT M"
Prompt E
1.76*E^.5\->\Q
H-Q/60\->\H
ClLCD
Disp "TEMP C"
Prompt T
Disp "PRESS HPA"
Prompt P
1/tan(H+7.31/(H+4.4))*(P/1010)*(283/(273+T))\->\R
H-R/60\->\H
0\->\K
0\->\Y
0\->\V
0\->\S
0\->\L
If B\>=\4
Goto Z
ClLCD
Disp "HP MIN"
Prompt V
If B\>=\3
Goto W
Disp "SD MIN"
Prompt S
Disp "LIMB 1L 2U 3C"
Prompt L
Lbl W
If abs(L-1)<.5
S\->\K
If abs(L-2)<.5
0-S\->\K
If abs(B-2)<.5
K*(1+sin(V/60)*sin(H))\->\K
H+K/60\->\H
If abs(V)<.005
Goto Z
\sin^-1\(sin(V/60)*cos(H))\->\Y
H+Y\->\H
Lbl Z
iPart(H)\->\D
fPart(H)*60\->\M
D+M/100\->\X
ClLCD
Disp "CORR MIN"
Disp K+60*Y-Q-R
Disp "HO DD.MMm"
Disp X
Pause
\STOP\
