\START\
\COMMENT=HO229 V1.3 sight reduction; Hc in DD.MMm, Z and Zn in degrees
\NAME=HO229
\FILE=HO229.85P
Degree
ClLCD
Disp "HO229 V1.3"
Disp "SIGHT REDUCTION"
Disp "DD.MMm INPUT"
Disp "LAT N+ S-"
Prompt A
1\->\S
If A<0
0-1\->\S
abs(A)\->\A
iPart(A)\->\D
fPart(A)*100\->\M
S*(D+M/60)\->\L
Disp "LHA DDD.MMm"
Prompt A
iPart(A)\->\D
fPart(A)*100\->\M
D+M/60\->\H
Disp "TOTAL DEC N+ S-"
Disp "d-CORR APPLIED"
Prompt A
1\->\S
If A<0
0-1\->\S
abs(A)\->\A
iPart(A)\->\D
fPart(A)*100\->\M
S*(D+M/60)\->\C
\sin^-1\(sin(L)*sin(C)+cos(L)*cos(C)*cos(H))\->\X
(sin(C)-sin(X)*sin(L))/(cos(X)*cos(L))\->\Q
If Q>1
1\->\Q
If Q<0-1
0-1\->\Q
\cos^-1\(Q)\->\Z
Z\->\N
If H<180
360-Z\->\N
If N\>=\360
N-360\->\N
If L<0
180-Z\->\Z
ClLCD
1\->\S
If X<0
0-1\->\S
abs(X)\->\A
iPart(A)\->\D
fPart(A)*60\->\M
S*(D+M/100)\->\R
Disp "HC DD.MMm"
Disp R
Disp "Z DEG"
Disp Z
Disp "ZN DEG"
Disp N
Pause
\STOP\
