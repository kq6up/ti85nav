\START\
\COMMENT=SUN V1.0 almanac: GHA, Dec, SD, eq of time
\NAME=SUN
\FILE=SUN.85P
Degree
ClLCD
Disp "SUN ALMANAC V1.0"
Disp "DATE YYYY.MMDD"
Prompt DT
Disp "UT HH.MMSS"
Prompt UT
iPart(DT)\->\YR
fPart(DT)*100\->\XX
iPart(XX+.00005)\->\MO
iPart(fPart(XX)*100+.5)\->\DY
iPart(UT)\->\HR
fPart(UT)*100\->\XX
HR+iPart(XX+.00005)/60+fPart(XX)/36\->\HR
367*YR-iPart(7*(YR+iPart((MO+9)/12))/4)\->\DN
DN+iPart(275*MO/9)+DY-730531.5+HR/24\->\DN
(DN+.0008)/36525\->\TC
280.46646+36000.76983*TC\->\LS
357.52911+35999.05029*TC\->\MA
(1.914602-.004817*TC)*sin(MA)\->\CE
CE+.019993*sin(2*MA)+.000289*sin(3*MA)\->\CE
125.04-1934.136*TC\->\OM
0-.00478*sin(OM)\->\PS
23.439291-.0130042*TC+.00256*cos(OM)\->\EP
280.46061837+360.98564736629*DN+PS*cos(EP)\->\GS
LS+CE-.00569+PS\->\LM
LM+.00134*cos(351.98+22518.7541*TC)\->\LM
LM+.00154*cos(254.08+45037.5082*TC)\->\LM
LM+.002*cos(157.05+32964.3577*TC)\->\LM
LM+.00179*sin(297.85+445267.1142*TC)\->\LM
LM+.00178*sin(251.39+20.2*TC)\->\LM
\sin^-1\(sin(EP)*sin(LM))\->\DX
(1-cos(EP))*sin(LM)*cos(LM)\->\QQ
cos(LM)*cos(LM)+cos(EP)*sin(LM)*sin(LM)\->\XX
\tan^-1\(QQ/XX)\->\QQ
GS-LM+QQ\->\GX
GX-360*iPart(GX/360)\->\GX
If GX<0
GX+360\->\GX
GX-15*HR-180\->\ET
ET-360*iPart(ET/360)\->\ET
If ET<0
ET+360\->\ET
If ET>180
ET-360\->\ET
4*ET\->\ET
15.994/(1.00014-.01671*cos(MA)-.00014*cos(2*MA))\->\SD
iPart(SD*10+.5)/10\->\SD
iPart(abs(GX)*600+.5)\->\KK
If KK\>=\216000
KK-216000\->\KK
iPart(KK/600)+(KK-600*iPart(KK/600))/1000\->\GH
iPart(abs(DX)*600+.5)\->\KK
iPart(KK/600)+(KK-600*iPart(KK/600))/1000\->\DC
If DX<0
0-DC\->\DC
iPart(abs(ET)*60+.5)\->\KK
iPart(KK/60)+(KK-60*iPart(KK/60))/100\->\EM
If ET<0
0-EM\->\EM
ClLCD
Disp "GHA DDD.MMm"
Disp GH
Disp "DEC N+ S-"
Disp DC
Disp "SD MINUTES"
Disp SD
Pause
ClLCD
Disp "EQ TIME MM.SS"
Disp "+ MEANS SUN FAST"
Disp EM
\STOP\
