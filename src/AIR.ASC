\START\
\COMMENT=AIR sextant corrections Hs to Ho from tables
\NAME=AIR
\FILE=AIR.85P
Degree
ClLCD
Disp "AIR HS TO HO"
Disp "HS DD.MMm"
Prompt X
iPart(X)\->\D
fPart(X)*100\->\M
D+M/60\->\H
Disp "IC MIN +ADD"
Prompt I
H+I/60\->\H
Disp "DIP MIN TABLE"
Prompt Q
H-Q/60\->\H
Disp "REFR MIN TABLE"
Prompt R
H-R/60\->\H
ClLCD
Disp "MOON P MIN"
Disp "0 IF NOT MOON"
Prompt V
H+V/60\->\H
Disp "SD MIN 0 IF CTR"
Prompt S
0\->\K
If abs(S)<.005
Goto Z
Disp "LIMB 1L 2U"
Prompt L
If abs(L-1)<.5
S\->\K
If abs(L-2)<.5
0-S\->\K
H+K/60\->\H
Lbl Z
iPart(H)\->\D
fPart(H)*60\->\M
D+M/100\->\X
ClLCD
Disp "DIP"
Disp 0-Q
Disp "REF"
Disp 0-R
Disp "PARA"
Disp V
Disp "SD"
Disp K
Disp "HO DD.MMm"
Disp X
Pause
\STOP\
