\START\
\COMMENT=MOON V1.0 almanac: GHA, Dec, HP, SD to 2 min
\NAME=MOON
\FILE=MOON.85P
Degree
ClLCD
Disp "MOON ALMANAC 1.0"
Disp "DATE YYYY.MMDD"
Prompt DT
Disp "UT HH.MMSS"
Prompt UT
iPart(DT)\->\YR
fPart(DT)*100\->\XX
iPart(XX+.00005)\->\MO
iPart(fPart(XX)*100+.5)\->\DY
iPart(UT)\->\HR
fPart(UT)*100\->\XX
HR+iPart(XX+.00005)/60+fPart(XX)/36\->\HR
367*YR-iPart(7*(YR+iPart((MO+9)/12))/4)\->\DN
DN+iPart(275*MO/9)+DY-730531.5+HR/24\->\DN
(DN+.0008)/36525\->\TC
357.52911+35999.05029*TC\->\MA
125.04-1934.136*TC\->\OM
0-.00478*sin(OM)\->\PS
23.439291-.0130042*TC+.00256*cos(OM)\->\EP
280.46061837+360.98564736629*DN+PS*cos(EP)\->\GS
297.8502+445267.1114*TC\->\EL
2*EL\->\E2
134.9634+477198.8675*TC\->\MM
93.2721+483202.0175*TC\->\FF
218.3164+481267.8812*TC+PS+6.2887*sin(MM)\->\LM
LM+1.274*sin(E2-MM)+.6581*sin(E2)+.2136*sin(2*MM)\->\LM
LM-.1849*sin(MA)-.1142*sin(2*FF)+.0588*sin(E2-2*MM)\->\LM
LM+.0569*sin(E2-MA-MM)+.0534*sin(E2+MM)\->\LM
LM+.0456*sin(E2-MA)-.0409*sin(MA-MM)-.0346*sin(EL)\->\LM
LM-.0305*sin(MA+MM)+.0153*sin(E2-2*FF)\->\LM
LM-.0128*sin(MM+2*FF)+.011*sin(MM-2*FF)\->\LM
LM+.0108*sin(2*E2-MM)+.01*sin(3*MM)\->\LM
LM+.0087*sin(2*E2-2*MM)-.008*sin(E2+MA-MM)\->\LM
LM-.0069*sin(E2+MA)-.005*sin(EL-MM)+.0049*sin(EL+MA)\->\LM
LM+.0039*sin(2*E2)+.0039*sin(E2+2*MM)\->\LM
LM+.0039*sin(E2+MM-MA)\->\LM
5.1277*sin(FF)+.2806*sin(MM+FF)+.2776*sin(MM-FF)\->\BM
BM+.1732*sin(E2-FF)+.0554*sin(E2+FF-MM)\->\BM
BM+.0463*sin(E2-MM-FF)+.0325*sin(E2+FF)\->\BM
BM+.0172*sin(2*MM+FF)+.0092*sin(E2+MM-FF)\->\BM
BM+.0088*sin(2*MM-FF)+.0082*sin(E2-MA-FF)\->\BM
BM+.0043*sin(E2-2*MM-FF)\->\BM
.9504+.0518*cos(MM)+.0096*cos(E2-MM)+.0079*cos(E2)\->\HP
cos(LM)*cos(BM)\->\XX
sin(LM)*cos(BM)*cos(EP)-sin(BM)*sin(EP)\->\YY
\sin^-1\(sin(BM)*cos(EP)+cos(BM)*sin(EP)*sin(LM))\->\DX
\tan^-1\(YY/XX)\->\RA
If XX<0
RA+180\->\RA
GS-RA\->\GX
GX-360*iPart(GX/360)\->\GX
If GX<0
GX+360\->\GX
iPart(HP*600+.5)/10\->\HP
iPart(2.725*HP+.5)/10\->\SD
iPart(abs(GX)*600+.5)\->\KK
If KK\>=\216000
KK-216000\->\KK
iPart(KK/600)+(KK-600*iPart(KK/600))/1000\->\GH
iPart(abs(DX)*600+.5)\->\KK
iPart(KK/600)+(KK-600*iPart(KK/600))/1000\->\DC
If DX<0
0-DC\->\DC
ClLCD
Disp "GHA DDD.MMm"
Disp GH
Disp "DEC N+ S-"
Disp DC
Disp "HP MINUTES"
Disp HP
Pause
ClLCD
Disp "SD MINUTES"
Disp SD
\STOP\
